# Postgres
POSTGRES_USER=production_monitoring
POSTGRES_PASSWORD=change-me
POSTGRES_DB=production_monitoring
DATABASE_URL=postgresql://production_monitoring:change-me@postgres:5432/production_monitoring

# MQTT
MQTT_BROKER_URL=mqtt://mosquitto:1883

# Backend
BACKEND_PORT=3000
BACKEND_WATCHDOG_OFFLINE_THRESHOLD_SEC=15

# Dashboard
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000/live

# ---------------------------------------------------------------------------
# Public read-only demo (only used by docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# Bare hostname Caddy issues the TLS cert for.
DEMO_DOMAIN=demo.example.com
# Same host with scheme — used as the backend CORS allow-list.
DEMO_PUBLIC_URL=https://demo.example.com
# Shown in the "run it locally" dialog / 403 body.
REPO_URL=https://github.com/your-username/production-monitoring
#
# For the demo build, point the dashboard at the public origin and override the
# two vars above:
#   VITE_API_BASE_URL=https://demo.example.com/api/v1
#   VITE_WS_URL=wss://demo.example.com/live
