generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Operational registry — who's connected, what state it's in, whether IT
// has it turned on. Asset/spec data (name, model, cost, maintenance interval,
// vendor, location...) intentionally does NOT live here anymore: it's owned
// by ErpMachineAsset so there's exactly one place to edit it. A Machine is
// always created FROM an existing ErpMachineAsset (Admin picks one — see
// admin.ts) rather than having its own copy that could drift out of sync.
model Machine {
  machineId         String    @id @map("machine_id")
  status            String    @default("OFFLINE")
  lastSeenAt        DateTime? @map("last_seen_at")
  // Wall-clock time of the last successful CSV import for this machine (see
  // import.ts). MANUAL machines have no telemetry to set lastSeenAt, so the
  // dashboard shows this instead — it's the closest thing MANUAL machines
  // have to a "last seen".
  lastImportedAt    DateTime? @map("last_imported_at")
  isActive          Boolean   @default(true) @map("is_active")
  // How this machine's data reaches the system — the coarse-grained view.
  // The fine-grained connection details (gateway, Modbus slave/registers)
  // live on MachineConnectionConfig; this stays as a fast, denormalised
  // column every view already reads.
  //   "SIMULATOR"      = prototype simulator container publishing MQTT itself
  //                      (also what a bare self-register defaults to).
  //   "MODBUS_GATEWAY" = real PLC polled over Modbus by a Protocol Gateway
  //                      that publishes the same MQTT payload (see README
  //                      "ถ้าเป็นเครื่องจักรจริง จะต่างจาก Simulator ตรงไหนบ้าง").
  //   "MANUAL_CSV"     = legacy machine with no data connection — history
  //                      comes only from CSV import (GAP_ANALYSIS §1.4).
  // Migrated from the old "MQTT"/"MANUAL" pair — see the
  // add_gateway_and_connection_config migration.
  dataSource        String    @default("SIMULATOR") @map("data_source")
  lastMaintenanceAt DateTime  @default(now()) @map("last_maintenance_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")

  asset            ErpMachineAsset          @relation(fields: [machineId], references: [assetId])
  connectionConfig MachineConnectionConfig?
  telemetry        MachineTelemetry[]
  statusEvents     MachineStatusEvent[]
  jobs             ProductionJob[]
  alarms           Alarm[]

  @@map("machines")
}

// A Protocol Gateway / Edge Adapter — the box that polls real PLCs over
// Modbus and republishes their readings as the same MQTT telemetry payload
// the simulator emits, so nothing downstream of the broker changes (README
// "ตัวกลางที่ต้องเพิ่มเข้ามา: Protocol Gateway"). A prototype has none of
// these; this table is what an Admin fills in when registering a physical
// machine instead of spinning up a simulator container.
model Gateway {
  gatewayId       String    @id @default(cuid()) @map("gateway_id")
  ipAddress       String    @map("ip_address")
  location        String
  // Last time this gateway reported in. NULL = never seen. A real deployment
  // would flip `status` from a heartbeat watchdog (same idea as watchdog.ts
  // does for machines); here it is set/cleared by hand from the Gateway
  // Management page.
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  status          String    @default("OFFLINE") // "ONLINE" | "OFFLINE"
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  connections MachineConnectionConfig[]

  @@map("gateways")
}

// Per-machine connection details. One row per Machine (machine_id is both PK
// and the FK, so the relation is 1:1). SIMULATOR / MANUAL_CSV rows carry
// only connection_type; MODBUS_TCP / MODBUS_RTU rows also carry the gateway
// link and the Modbus addressing an Admin typed in at registration time.
model MachineConnectionConfig {
  machineId String @id @map("machine_id")
  // "SIMULATOR" | "MODBUS_TCP" | "MODBUS_RTU" | "MANUAL_CSV"
  connectionType String  @map("connection_type")
  gatewayId      String? @map("gateway_id")
  modbusSlaveId  Int?    @map("modbus_slave_id")
  modbusIp       String? @map("modbus_ip")
  modbusPort     Int?    @map("modbus_port")
  // Raw Modbus register addresses the gateway reads and maps into the
  // telemetry payload, e.g. { "pressure": 40001, "temperature": 40002 }.
  registerMap Json?    @map("register_map")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  machine Machine  @relation(fields: [machineId], references: [machineId], onDelete: Cascade)
  gateway Gateway? @relation(fields: [gatewayId], references: [gatewayId])

  // No two machines on the same gateway may claim the same Modbus slave id.
  // Postgres treats NULLs as distinct, so the many SIMULATOR/MANUAL_CSV rows
  // (gateway_id = NULL, modbus_slave_id = NULL) don't collide with each other.
  @@unique([gatewayId, modbusSlaveId])
  @@map("machine_connection_configs")
}

// Mock ERP master data for machine assets — same idea as ProductSku below,
// just for equipment instead of products. This is the single source of truth
// for "what is this machine, what does it cost to run, when's it due for
// maintenance, who sold it to us" — edited only from the ERP page. Admin's
// "register new machine" flow picks a row here by assetId instead of typing
// these fields in free-text, which is what used to let the same physical
// machine end up with mismatched specs registered in two places.
model ErpMachineAsset {
  assetId                  String    @id @map("asset_id")
  machineName              String    @map("machine_name")
  machineModel             String?   @map("machine_model")
  ratedPowerKw             Decimal?  @map("rated_power_kw") @db.Decimal(8, 2)
  laborCostPerHour         Decimal?  @map("labor_cost_per_hour") @db.Decimal(10, 2)
  targetCycleTimeSec       Decimal?  @map("target_cycle_time_sec") @db.Decimal(6, 2)
  maintenanceIntervalHours Decimal?  @map("maintenance_interval_hours") @db.Decimal(8, 2)
  vendorName               String?   @map("vendor_name")
  purchaseDate             DateTime? @map("purchase_date")
  location                 String?
  manufacturerPhone        String?   @map("manufacturer_phone")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  machine Machine?

  @@map("erp_machine_assets")
}

model MachineTelemetry {
  id                   BigInt   @id @default(autoincrement())
  machineId            String   @map("machine_id")
  timestamp            DateTime
  status               String
  cycleTimeSec         Decimal? @map("cycle_time_sec") @db.Decimal(6, 2)
  shotCount            Int?     @map("shot_count")
  injectionPressureBar Decimal? @map("injection_pressure_bar") @db.Decimal(6, 2)
  barrelTemperatureC   Decimal? @map("barrel_temperature_c") @db.Decimal(6, 2)

  machine Machine @relation(fields: [machineId], references: [machineId])

  @@index([machineId, timestamp])
  @@map("machine_telemetry")
}

model MachineStatusEvent {
  id         BigInt   @id @default(autoincrement())
  machineId  String   @map("machine_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedAt  DateTime @map("changed_at")

  machine Machine @relation(fields: [machineId], references: [machineId])

  @@index([machineId, changedAt])
  @@map("machine_status_events")
}

model ProductionJob {
  jobNumber       String    @id @map("job_number")
  machineId       String    @map("machine_id")
  productCode     String    @map("product_code")
  moldId          String?   @map("mold_id")
  recipeId        String?   @map("recipe_id")
  startTime       DateTime  @map("start_time")
  endTime         DateTime? @map("end_time")
  goodQty         Int       @default(0) @map("good_qty")
  rejectQty       Int       @default(0) @map("reject_qty")
  startupScrapQty Int       @default(0) @map("startup_scrap_qty")
  status          String    @default("RUNNING")

  machine Machine @relation(fields: [machineId], references: [machineId])
  alarms  Alarm[]

  @@index([machineId])
  @@map("production_jobs")
}

model Alarm {
  id               BigInt    @id @default(autoincrement())
  machineId        String    @map("machine_id")
  jobNumber        String?   @map("job_number")
  alarmCode        String    @map("alarm_code")
  alarmMessage     String    @map("alarm_message")
  alarmTimestamp   DateTime  @map("alarm_timestamp")
  clearedTimestamp DateTime? @map("cleared_timestamp")

  machine Machine        @relation(fields: [machineId], references: [machineId])
  job     ProductionJob? @relation(fields: [jobNumber], references: [jobNumber])

  @@index([machineId, alarmTimestamp])
  @@map("alarms")
}

// Mock ERP master data: assumed sell price / material cost per SKU (product
// code). There's no real ERP integration (see README Automation Pyramid —
// this system sits at Level 2, ERP is Level 4), so this is a small
// admin-editable price book that lets the Executive KPI / ERP views turn
// good/reject quantities into revenue, cost, and margin for illustration.
model ProductSku {
  productCode            String   @id @map("product_code")
  description            String?
  unitPriceThb           Decimal  @map("unit_price_thb") @db.Decimal(10, 2)
  materialCostPerUnitThb Decimal? @map("material_cost_per_unit_thb") @db.Decimal(10, 2)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("product_skus")
}

// Mock ERP "order obtained from ERP" data — deliberately decoupled from
// ProductionJob (no FK, just a shared jobNumber/productCode by convention,
// same "logical join, not a real one" pattern as ProductSku above). Backend
// auto-upserts a row here whenever a production job starts (see
// mqtt/subscriber.ts handleJob), so this stays populated without anyone
// hand-keying it; it's also directly editable in ERP like SKU Pricing.
// Reconciling this against actual good/reject output is a manual step for
// later, not automatic — see README "สมมติฐานและข้อจำกัด".
model ErpJobOrder {
  jobNumber       String   @id @map("job_number")
  productCode     String   @map("product_code")
  quantityOrdered Int      @map("quantity_ordered")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("erp_job_orders")
}

// Programmatic log of who changed what in Admin (machine config, activation,
// maintenance, CSV import) — answers Direction.md §4.2 "มี Log สำหรับตรวจสอบ
// การทำงานเบื้องต้น". No auth yet, so `actor` is a free-text label; once auth
// lands this becomes the authenticated user id.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actor      String
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}
